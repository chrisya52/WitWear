---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/products.json';

export const prerender = true;

export function getStaticPaths() {
  return products.map(product => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<BaseLayout title={product.name}>
  <Navbar />
  <main class="container mx-auto px-4 py-12 flex-grow">
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Product Image -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 flex items-center justify-center">
        <img src={product.mockup_url || product.image_url} alt={product.name} class="max-w-full max-h-[500px] object-contain" />
      </div>

      <!-- Product Info -->
      <div>
        <h1 class="text-4xl font-extrabold mb-4">{product.name}</h1>
        <p class="text-2xl text-indigo-600 font-bold mb-6">${product.price}</p>
        
        <div class="prose prose-indigo mb-8">
          <p class="text-gray-600 text-lg">{product.description}</p>
        </div>

        <div class="space-y-6">
          <button 
            id="add-to-cart"
            data-product={JSON.stringify(product)}
            class="w-full bg-indigo-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Add to Cart
          </button>
          
          <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
            <p class="text-sm text-gray-500 font-medium uppercase tracking-wider mb-2">Print-on-Demand Fulfillment</p>
            <p class="text-gray-600">This product is custom-made for you. Ships in 3-5 business days. No inventory risk, just fresh threads.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />

  <script>
    import { addToCart } from '../../store/cart';
    const buyButton = document.getElementById('add-to-cart');
    const productData = JSON.parse(buyButton?.getAttribute('data-product') || '{}');
    
    buyButton?.addEventListener('click', async () => {
      addToCart(productData);
      buyButton.textContent = 'Added to Cart!';
      buyButton.classList.remove('bg-indigo-600');
      buyButton.classList.add('bg-green-600');
      
      setTimeout(() => {
        buyButton.textContent = 'Add to Cart';
        buyButton.classList.remove('bg-green-600');
        buyButton.classList.add('bg-indigo-600');
      }, 2000);
    });
  </script>
</BaseLayout>
